generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String?
  phone            String?         @unique
  address          String?
  password         String?
  emailVerified    Int             @default(0)
  emailToken       String?
  newEmail         String?
  resetToken       String?
  resetTokenExpiry String?
  role             String          @default("user")
  avatar           String?
  isBanned         Boolean         @default(false)
  bannedAt         DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  addresses        Address[]
  adminLogs        AdminLog[]
  cartItems        CartItem[]
  orders           Order[]
  posts            Post[]
  productReviews   ProductReview[]
  wishlistItems    WishlistItem[]

  @@map("users")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  division     String
  postalCode   String?
  isDefault    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@map("addresses")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  description     String?
  categoryId      String
  price           Float                  @default(0)
  basePrice       Float                  @default(0)
  comparePrice    Float?
  discount        Float                  @default(0)
  discountType    String                 @default("percentage")
  images          String?
  stock           Int                    @default(0)
  lowStockAlert   Int                    @default(10)
  reorderLevel    Int                    @default(5)
  reorderQty      Int                    @default(20)
  isActive        Int                    @default(1)
  isFeatured      Int                    @default(0)
  hasVariants     Int                    @default(0)
  weight          Float?
  dimensions      String?
  tags            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  costPrice       Float?                 @default(0)
  cartItems       CartItem[]
  inventoryAlerts InventoryAlert[]
  reservations    InventoryReservation[]
  orderItems      OrderItem[]
  reviews         ProductReview[]
  variants        ProductVariant[]
  category        Category               @relation(fields: [categoryId], references: [id])
  wishlistItems   WishlistItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@map("products")
}

model ProductVariant {
  id              String                 @id @default(cuid())
  productId       String
  sku             String                 @unique
  name            String
  price           Float
  comparePrice    Float?
  stock           Int                    @default(0)
  images          String?
  size            String?
  color           String?
  material        String?
  isActive        Int                    @default(1)
  isDefault       Int                    @default(0)
  lowStockAlert   Int                    @default(10)
  reorderLevel    Int                    @default(5)
  reorderQty      Int                    @default(20)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  costPrice       Float?                 @default(0)
  cartItems       CartItem[]
  inventoryAlerts InventoryAlert[]
  reservations    InventoryReservation[]
  orderItems      OrderItem[]
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([productId, isActive])
  @@index([productId, size, color])
  @@map("product_variants")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  userName   String?
  rating     Int
  title      String?
  comment    String?
  isVerified Int      @default(0)
  isApproved Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@index([productId, rating(sort: Desc)])
  @@index([userId])
  @@index([isApproved, createdAt(sort: Desc)])
  @@map("product_reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  shippingAddress       String
  billingAddress        String?
  city                  String?
  district              String?
  division              String?
  subtotal              Float
  shipping              Float       @default(0)
  tax                   Float       @default(0)
  discount              Float       @default(0)
  total                 Float
  status                String      @default("PENDING")
  paymentStatus         String      @default("PENDING")
  paymentMethod         String?
  trackingNumber        String?
  trackingStatus        String      @default("PENDING")
  estimatedDeliveryDate String?
  cancelledAt           String?
  cancelledBy           String?
  cancellationReason    String?
  refundedAt            String?
  refundedAmount        Float?
  refundMethod          String?
  refundReason          String?
  notes                 String?
  deletedAt             DateTime?
  deletedBy             String?
  deletedReason         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  promoCode             String?
  items                 OrderItem[]
  user                  User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([customerEmail])
  @@index([orderNumber])
  @@index([status, createdAt(sort: Desc)])
  @@index([customerEmail, status])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  price           Float
  productName     String
  productImage    String?
  variantSku      String?
  variantSize     String?
  variantColor    String?
  variantMaterial String?
  createdAt       DateTime        @default(now())
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([userId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  adminId   String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([entity, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("admin_logs")
}

model InventoryAlert {
  id         String          @id @default(cuid())
  variantId  String?
  productId  String?
  alertType  String          @default("LOW_STOCK")
  quantity   Int
  isRead     Int             @default(0)
  isResolved Int             @default(0)
  resolvedAt String?
  createdAt  DateTime        @default(now())
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@index([isRead, isResolved])
  @@map("inventory_alerts")
}

model InventoryReservation {
  id        String          @id @default(cuid())
  variantId String?
  productId String?
  userId    String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime        @default(now())
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@index([userId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("posts")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String
  mobileImage String?
  buttonText  String?
  buttonLink  String?
  isActive    Int      @default(1)
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("banners")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  thumbnail String
  images    String
  isActive  Int      @default(1)
  order     Int      @default(0) @map("displayOrder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("stories")
}

model Reel {
  id         String   @id @default(cuid())
  title      String
  thumbnail  String
  videoUrl   String
  productIds String?
  isActive   Int      @default(1)
  order      Int      @default(0) @map("displayOrder")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("reels")
}

model Promotion {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  image                String
  ctaText              String?
  ctaLink              String?
  type                 String    @default("banner")
  promoCode            String?   @unique
  discountType         String?
  discountValue        Float?
  minOrderAmount       Float?
  maxDiscountAmount    Float?
  startDate            DateTime?
  endDate              DateTime?
  usageLimit           Int?
  usedCount            Int       @default(0)
  userLimit            Int?
  applicableCategories String?
  applicableProducts   String?
  conditions           String?
  isActive             Int       @default(1)
  order                Int       @default(0) @map("displayOrder")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isActive])
  @@index([type, isActive])
  @@index([promoCode])
  @@map("promotions")
}

model HomepageSettings {
  id           String   @id @default(cuid())
  sectionName  String   @unique
  isEnabled    Int      @default(1)
  autoPlay     Int      @default(5000)
  displayLimit Int?
  settings     String?
  updatedAt    DateTime @default(now())
}

model SiteSettings {
  id                    String   @id @default(cuid())
  siteName              String   @default("SCommerce")
  siteLogo              String?
  currency              String   @default("BDT")
  currencySymbol        String   @default("৳")
  taxRate               Float    @default(0.18)
  freeShippingThreshold Float    @default(5000)
  baseShippingCost      Float    @default(150)
  contactEmail          String?
  contactPhone          String?
  socialMedia           String?
  seo                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

model PaymentGateway {
  id         String    @id @default(cuid())
  name       String    @unique
  provider   String    @default("custom")
  apiKey     String?
  apiSecret  String?
  webhookUrl String?
  isActive   Boolean   @default(true)
  isDefault  Boolean   @default(false)
  settings   String?
  lastTested DateTime?
  testStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("payment_gateways")
}

model ShippingCarrier {
  id            String    @id @default(cuid())
  name          String    @unique
  provider      String    @default("custom")
  apiKey        String?
  apiSecret     String?
  accountNumber String?
  webhookUrl    String?
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  settings      String?
  lastTested    DateTime?
  testStatus    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("shipping_carriers")
}

model AnalyticsIntegration {
  id         String   @id @default(cuid())
  name       String   @unique
  provider   String   @default("custom")
  trackingId String?
  apiKey     String?
  pixelId    String?
  isActive   Boolean  @default(true)
  settings   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("analytics_integrations")
}

model EmailService {
  id         String    @id @default(cuid())
  name       String    @unique
  provider   String    @default("custom")
  apiKey     String?
  apiSecret  String?
  fromEmail  String?
  fromName   String?
  webhookUrl String?
  isActive   Boolean   @default(true)
  isDefault  Boolean   @default(false)
  settings   String?
  lastTested DateTime?
  testStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("email_services")
}

model ImageGallery {
  id           String   @id @default(cuid())
  filename     String
  url          String   @unique
  originalName String?
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  alt          String?
  tags         String?
  category     String?
  usageCount   Int      @default(0)
  isActive     Boolean  @default(true)
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, createdAt(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([usageCount(sort: Desc)])
  @@map("image_gallery")
}
