// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  phone           String?   @unique
  address         String?
  password        String?
  emailVerified   Int       @default(0)
  emailToken      String?
  newEmail        String?
  resetToken      String?
  resetTokenExpiry String?
  role            String    @default("user")
  avatar          String?
  isBanned        Boolean   @default(false)
  bannedAt        DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  addresses       Address[]
  orders          Order[]     @relation("user_orders")
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  productReviews  ProductReview[]
  posts           Post[]
  adminLogs       AdminLog[]    @relation("user_admin_logs")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  district      String?
  division      String
  postalCode    String?
  isDefault     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Note: userId index automatically created by foreign key constraint
  @@index([isDefault])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  // Note: slug index automatically created by unique constraint
  @@index([isActive])
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  categoryId      String
  price           Float             @default(0)
  basePrice       Float             @default(0)
  comparePrice    Float?
  discount        Float             @default(0)
  discountType    String            @default("percentage")
  images          String?
  stock           Int               @default(0)
  lowStockAlert   Int               @default(10)
  reorderLevel    Int               @default(5)
  reorderQty      Int               @default(20)
  isActive        Int               @default(1)
  isFeatured      Int               @default(0)
  hasVariants     Int               @default(0)
  weight          Float?
  dimensions      String?
  tags            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        Category          @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  reviews         ProductReview[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  inventoryAlerts InventoryAlert[]

  // Note: categoryId index automatically created by foreign key constraint
  // Note: slug index automatically created by unique constraint
  @@index([isFeatured])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  name          String
  price         Float
  comparePrice  Float?
  stock         Int      @default(0)
  images        String?
  size          String?
  color         String?
  material      String?
  isActive      Int      @default(1)
  isDefault     Int      @default(0)
  lowStockAlert Int      @default(10)
  reorderLevel  Int      @default(5)
  reorderQty    Int      @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryAlerts InventoryAlert[]

  // Note: productId index automatically created by foreign key constraint
  // Note: sku index automatically created by unique constraint
  @@index([isActive])
  @@index([productId, isActive])
  @@index([size, color])
}

model ProductReview {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  userName    String?
  rating      Int
  title       String?
  comment     String?
  isVerified  Int      @default(0)
  isApproved  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@index([productId, rating(sort: Desc)])
  @@index([userId])
  @@index([isApproved, createdAt(sort: Desc)])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String   @id @default(cuid())
  orderNumber           String   @unique
  userId                String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  shippingAddress       String
  billingAddress        String?
  city                  String?
  district              String?
  division              String?
  subtotal              Float
  shipping              Float    @default(0)
  tax                   Float    @default(0)
  discount              Float    @default(0)
  total                 Float
  status                String   @default("PENDING")
  paymentStatus         String   @default("PENDING")
  paymentMethod         String?
  trackingNumber        String?
  trackingStatus        String   @default("PENDING")
  estimatedDeliveryDate String?
  cancelledAt           String?
  cancelledBy           String?
  cancellationReason    String?
  refundedAt            String?
  refundedAmount        Float?
  refundMethod          String?
  refundReason          String?
  notes                 String?
  deletedAt             DateTime?
  deletedBy             String?
  deletedReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User?    @relation("user_orders", fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]

  // Note: userId index automatically created by foreign key constraint
  @@index([customerEmail])
  @@index([orderNumber])
  @@index([status, createdAt(sort: Desc)])
  @@index([customerEmail, status])
  @@index([deletedAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  price           Float
  productName     String
  productImage    String?
  variantSku      String?
  variantSize     String?
  variantColor    String?
  variantMaterial String?
  createdAt       DateTime @default(now())
  order           Order          @relation(fields: [orderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Note: orderId, productId, variantId indexes automatically created by foreign key constraints
  // Note: productId cannot have onDelete: SetNull because it's required (not nullable)
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Note: unique constraint creates index automatically
  @@unique([userId, productId, variantId])
  // Note: userId and productId indexes covered by unique constraint
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  adminId   String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     User     @relation("user_admin_logs", fields: [adminId], references: [id], onDelete: Cascade)

  // Note: adminId index automatically created by foreign key constraint
  @@index([entity, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
}

model InventoryAlert {
  id         String   @id @default(cuid())
  variantId  String?
  productId  String?
  alertType  String   @default("LOW_STOCK")
  quantity   Int
  isRead     Int      @default(0)
  isResolved Int      @default(0)
  resolvedAt String?
  createdAt  DateTime @default(now())
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@index([isRead, isResolved])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String
  mobileImage String?
  buttonText  String?
  buttonLink  String?
  isActive    Int      @default(1)
  order       Int      @default(0) @map("displayOrder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("banners")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  thumbnail String
  images    String
  isActive  Int      @default(1)
  order     Int      @default(0) @map("displayOrder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("stories")
}

model Reel {
  id         String   @id @default(cuid())
  title      String
  thumbnail  String
  videoUrl   String
  productIds String?
  isActive   Int      @default(1)
  order      Int      @default(0) @map("displayOrder")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("reels")
}

model Promotion {
  id        String   @id @default(cuid())
  title     String
  description String?
  image     String
  ctaText   String?
  ctaLink   String?
  type      String   @default("banner")
  isActive  Int      @default(1)
  order     Int      @default(0) @map("displayOrder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([type, isActive])
  @@map("promotions")
}

model HomepageSettings {
  id          String   @id @default(cuid())
  sectionName String   @unique
  isEnabled   Int      @default(1)
  autoPlay    Int      @default(5000)
  displayLimit Int?
  settings    String?
  updatedAt   DateTime @default(now())
}
