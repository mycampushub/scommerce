// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ============================================================================
// CASCADE DELETE POLICY
// ============================================================================
// This schema uses explicit cascade delete rules for data integrity.
//
// RELATIONS WITH CASCADE DELETE (automatic cleanup on parent deletion):
// - Address -> User (when user deleted, all addresses are deleted)
// - WishlistItem -> User (when user deleted, wishlist items are deleted)
// - WishlistItem -> Product (when product deleted, wishlist items are deleted)
// - ProductVariant -> Product (when product deleted, all variants are deleted)
// - CartItem variant -> ProductVariant (when variant deleted, cart items reference is set to null)
// - InventoryAlert -> ProductVariant (when variant deleted, alerts are deleted)
// - InventoryAlert -> Product (when product deleted, alerts are deleted)
//
// RELATIONS WITH RESTRICT (prevent deletion if children exist):
// - Order -> User (orders cannot be deleted if user exists, must handle via application logic)
//
// IMPORTANT: Order and OrderItem cascade is handled via application transactions.
// The deleteWithItems() method in OrderRepository handles atomic deletion.
// See: /src/db/order.repository.ts
//
// ============================================================================

// ============================================================================
// CURRENCY PRECISION CONSIDERATIONS
// ============================================================================
// This schema uses Float for currency values (price, basePrice, subtotal, total, etc.).
//
// CURRENT IMPLEMENTATION (Float):
// - All monetary values are stored as Float (IEEE 754 double-precision)
// - Currency: BDT (Bangladeshi Taka) - ৳
// - Float precision: ~15-17 significant decimal digits
// - Potential issues: Floating-point arithmetic can cause rounding errors
//   Example: 0.1 + 0.2 = 0.30000000000000004
//
// RECOMMENDATION FOR PRODUCTION:
// Consider migrating to Integer-based currency storage for better precision:
// - Store values in smallest currency unit (paisa: 1 BDT = 100 paisa)
// - Example: ৳123.45 stored as 12345 (integer)
// - Convert when displaying: divide by 100 for display value
// - Benefits: No floating-point rounding errors, precise calculations
//
// EXAMPLE MIGRATION:
// - Old: price Float @default(0) // Stores 123.45 as float
// - New: price Int @default(0) // Stores 12345 (123.45 * 100)
//
// NOTE: For now, the Float implementation is acceptable for most use cases.
// BDT uses 2 decimal places, and Float can handle typical e-commerce prices accurately.
// Only consider integer migration if you encounter precision issues in production.
//
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  phone           String?
  address         String?
  password        String?
  emailVerified   Int       @default(0)
  emailToken      String?
  newEmail        String?
  resetToken      String?
  resetTokenExpiry String?
  role            String    @default("user")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  addresses       Address[]
  orders          Order[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  productReviews  ProductReview[]
  posts           Post[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  district      String?
  division      String
  postalCode    String?
  isDefault     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
}

// ============================================================================
// PRODUCT PRICING EXPLANATION
// ============================================================================
// Products have multiple price fields for different purposes:
//
// basePrice: The original/reference price before discounts
//   - Used as baseline for calculations
//   - Should not change unless base cost changes
//   - Used for profit margin calculations
//
// price: The current selling price displayed to customers
//   - This is what customers see in the UI
//   - Includes discounts: price = basePrice - discount
//   - Updated when discounts are applied/removed
//
// comparePrice: Optional "original price" for marketing
//   - Shows crossed-out price during sales
//   - Creates "save X%" messaging
//   - Example: Compare: ৳1000, Now: ৳750 (25% off)
//
// discount: Discount amount to apply to basePrice
//   - discountType "percentage": discount is percent (e.g., 25 for 25%)
//   - discountType "fixed": discount is amount (e.g., 100 for ৳100 off)
//
// ============================================================================

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  categoryId      String
  price           Float             @default(0)
  basePrice       Float             @default(0)
  comparePrice    Float?
  discount        Float             @default(0)
  discountType    String            @default("percentage")
  images          String?
  stock           Int               @default(0)
  lowStockAlert   Int               @default(10)
  reorderLevel    Int               @default(5)
  reorderQty      Int               @default(20)
  isActive        Int               @default(1)
  isFeatured      Int               @default(0)
  hasVariants     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        Category          @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  reviews         ProductReview[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  inventoryAlerts InventoryAlert[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([slug])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  name          String
  price         Float
  comparePrice  Float?
  stock         Int      @default(0)
  images        String?
  size          String?
  color         String?
  material      String?
  isActive      Int      @default(1)
  isDefault     Int      @default(0)
  lowStockAlert Int      @default(10)
  reorderLevel  Int      @default(5)
  reorderQty    Int      @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryAlerts InventoryAlert[]

  @@index([productId])
  @@index([sku])
  @@index([productId, isActive])
  @@index([productId, size, color])
}

model ProductReview {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  userName    String?
  rating      Int
  title       String?
  comment     String?
  isVerified  Int      @default(0)
  isApproved  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String   @id @default(cuid())
  orderNumber           String   @unique
  userId                String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  shippingAddress       String
  billingAddress        String?
  city                  String?
  district              String?
  division              String?
  subtotal              Float
  shipping              Float    @default(0)
  tax                   Float    @default(0)
  discount              Float    @default(0)
  total                 Float
  status                String   @default("PENDING")
  paymentStatus         String   @default("PENDING")
  paymentMethod         String?
  trackingNumber        String?
  trackingStatus        String   @default("PENDING")
  estimatedDeliveryDate String?
  cancelledAt           String?
  cancelledBy           String?
  cancellationReason    String?
  refundedAt            String?
  refundedAmount        Float?
  refundMethod          String?
  refundReason          String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                 OrderItem[]

  @@index([userId])
  @@index([customerEmail])
  @@index([orderNumber])
  @@index([status, createdAt(sort: Desc)])
  @@index([customerEmail, status])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  price           Float
  productName     String
  productImage    String?
  variantSku      String?
  variantSize     String?
  variantColor    String?
  variantMaterial String?
  createdAt       DateTime @default(now())
  order           Order          @relation(fields: [orderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, productId])
  @@index([variantId])
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  adminId   String
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}

model InventoryAlert {
  id         String   @id @default(cuid())
  variantId  String?
  productId  String?
  alertType  String   @default("LOW_STOCK")
  quantity   Int
  isRead     Int      @default(0)
  isResolved Int      @default(0)
  resolvedAt String?
  createdAt  DateTime @default(now())
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([productId])
  @@index([isRead, isResolved])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String
  mobileImage String?
  buttonText  String?
  buttonLink  String?
  isActive    Int      @default(1)
  order       Int      @default(0) @map("displayOrder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("banners")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  thumbnail String
  images    String
  isActive  Int      @default(1)
  order     Int      @default(0) @map("displayOrder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("stories")
}

model Reel {
  id         String   @id @default(cuid())
  title      String
  thumbnail  String
  videoUrl   String
  productIds String?
  isActive   Int      @default(1)
  order      Int      @default(0) @map("displayOrder")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("reels")
}

model Promotion {
  id        String   @id @default(cuid())
  title     String
  description String?
  image     String
  ctaText   String?
  ctaLink   String?
  type      String   @default("banner")
  isActive  Int      @default(1)
  order     Int      @default(0) @map("displayOrder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([type, isActive])
  @@map("promotions")
}

model HomepageSettings {
  id          String   @id @default(cuid())
  sectionName String   @unique
  isEnabled   Int      @default(1)
  autoPlay    Int      @default(5000)
  displayLimit Int?
  settings    String?
  updatedAt   DateTime @default(now())
}

model AdminSettings {
  id            String   @id @default(cuid())
  settingsData   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
