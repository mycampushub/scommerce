# OpenNext Cloudflare Pages configuration for scommerce
name = "scommerce"
compatibility_date = "2026-04-26"
compatibility_flags = ["nodejs_compat"]

# Build configuration for OpenNext
[build]
command = "npm run build"
cwd = "."
watch_dir = ".next/open-next"

# Output directory (required by Cloudflare Pages)
pages_build_output_dir = ".next/open-next"

# D1 Database bindings
[[d1_databases]]
binding = "DB"
database_name = "scommerce-db"
database_id = "fccab55b-37e3-4544-aacd-9095df3e9ab3"

# R2 Storage for file uploads
[[r2_buckets]]
binding = "BUCKET"
bucket_name = "scommerce-uploads"

# KV Namespace for rate limiting and caching
[[kv_namespaces]]
binding = "KV"
id = "88d9b0d91f674eeab798ba907b15c716"

[observability]
enabled = true
