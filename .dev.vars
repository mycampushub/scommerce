# Cloudflare Workers Environment Variables for Local Development
# Copy this file to .dev.vars.local for your local values

# JWT Secret for token generation and verification
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-long

# Admin registration secret (allows admin role during registration)
ADMIN_SECRET=your-admin-registration-secret-change-in-production

# Public URL for email verification links
NEXT_PUBLIC_URL=http://localhost:3000

# Database is configured in wrangler.toml
# No DATABASE_URL needed for Cloudflare Workers deployment
